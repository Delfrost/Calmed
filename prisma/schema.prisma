// Healthcare SaaS — Vertical OS for Polyclinics & Pharmacies
// Full PostgreSQL Database Schema via Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserRole {
  ADMIN
  DOCTOR
  RECEPTIONIST
  PHARMACIST
  NURSE
}

enum AppointmentStatus {
  SCHEDULED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum QueueStatus {
  WAITING
  IN_PROGRESS
  COMPLETED
  SKIPPED
  CANCELLED
}

enum PrescriptionStatus {
  DRAFT
  FINALIZED
  SENT_TO_PHARMACY
  PARTIALLY_DISPENSED
  DISPENSED
  CANCELLED
}

enum BatchStatus {
  ACTIVE
  EXPIRED
  RECALLED
  DEPLETED
}

enum StockMovementType {
  PURCHASE
  DISPENSED
  RETURNED
  EXPIRED
  DAMAGED
  ADJUSTMENT
}

enum InvoiceStatus {
  DRAFT
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH
  UPI
  CREDIT_CARD
  DEBIT_CARD
  BANK_TRANSFER
  INSURANCE
}

enum InvoiceItemType {
  CONSULTATION
  MEDICINE
  LAB_TEST
  PROCEDURE
  OTHER
}

enum LabOrderStatus {
  ORDERED
  SAMPLE_COLLECTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PayoutStatus {
  PENDING
  CALCULATED
  APPROVED
  PAID
}

enum RefillStatus {
  SCHEDULED
  SENT
  ACKNOWLEDGED
  CANCELLED
}

// ============================================================================
// IPD ENUMS
// ============================================================================

enum BedStatus {
  VACANT
  OCCUPIED
  MAINTENANCE
  HOUSEKEEPING
  RESERVED
}

enum WardType {
  GENERAL
  SEMI_PRIVATE
  PRIVATE
  ICU
  NICU
  PICU
  HDU
}

enum AdmissionStatus {
  REQUESTED
  ADMITTED
  TRANSFERRED
  DISCHARGED
  CANCELLED
}

enum AdmissionSource {
  OPD
  EMERGENCY
  DIRECT
  TRANSFER
}

enum ShiftType {
  MORNING
  AFTERNOON
  NIGHT
}

enum MARStatus {
  SCHEDULED
  ADMINISTERED
  MISSED
  HELD
  REFUSED
}

enum SurgeryStatus {
  SCHEDULED
  PRE_OP
  IN_PROGRESS
  POST_OP
  COMPLETED
  CANCELLED
}

enum TPAStatus {
  PRE_AUTH_PENDING
  PRE_AUTH_APPROVED
  PRE_AUTH_REJECTED
  CLAIM_SUBMITTED
  CLAIM_APPROVED
  CLAIM_REJECTED
  CLAIM_SETTLED
}

// ============================================================================
// CLINIC (Root Entity)
// ============================================================================

model Clinic {
  id          String   @id @default(cuid())
  name        String
  address     String
  phone       String
  email       String?
  logo        String?  // URL to clinic logo
  licenseNo   String?
  
  // Settings
  consultationFee    Decimal  @default(0) @db.Decimal(10, 2)
  defaultDoctorSplit Decimal  @default(70) @db.Decimal(5, 2) // percentage
  currency           String   @default("INR")
  timezone           String   @default("Asia/Kolkata")

  // Relations
  users        User[]
  patients     Patient[]
  appointments Appointment[]
  queueTokens  QueueToken[]
  medicines    Medicine[]
  labTests     LabTest[]
  invoices     Invoice[]
  payouts      DoctorPayout[]

  // IPD Relations
  wards        Ward[]
  admissions   Admission[]
  surgeries    Surgery[]
  ipdBills     IPDBill[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================================
// RBAC — Users & Doctor Profiles
// ============================================================================

model User {
  id           String   @id @default(cuid())
  clinicId     String
  clinic       Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  role         UserRole
  isActive     Boolean  @default(true)
  avatarUrl    String?

  // Doctor-specific profile (null for non-doctors)
  doctorProfile DoctorProfile?

  // Audit trail
  auditLogs AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clinicId])
  @@index([role])
  @@index([email])
}

model DoctorProfile {
  id             String  @id @default(cuid())
  userId         String  @unique
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  specialization String
  qualification  String?
  licenseNumber  String  @unique
  experience     Int?    // years of experience
  
  // Schedule & availability
  consultationDuration Int     @default(15) // minutes per patient
  isVisiting           Boolean @default(false) // visiting doctor vs permanent
  
  // Revenue split
  revenueSplitPercent Decimal @default(70) @db.Decimal(5, 2)

  // Relations
  appointments  Appointment[]
  prescriptions Prescription[]
  queueTokens   QueueToken[]
  payouts       DoctorPayout[]

  // IPD Relations
  admittedPatients   Admission[] @relation("AdmittingDoctor")
  attendingPatients  Admission[] @relation("AttendingDoctor")
  progressNotes      ProgressNote[]
  leadSurgeries      Surgery[]   @relation("LeadSurgeon")
  anesthetistSurgeries Surgery[] @relation("Anesthetist")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([specialization])
}

// ============================================================================
// PATIENTS (External — interact via WhatsApp)
// ============================================================================

model Patient {
  id        String @id @default(cuid())
  clinicId  String
  clinic    Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  firstName   String
  lastName    String
  phone       String   // Primary — used for WhatsApp
  email       String?
  dateOfBirth DateTime?
  gender      String?
  bloodGroup  String?
  address     String?
  
  // Medical info
  allergies       String[] // PostgreSQL array
  chronicConditions String[]
  emergencyContactName  String?
  emergencyContactPhone String?

  // Relations
  appointments   Appointment[]
  prescriptions  Prescription[]
  queueTokens    QueueToken[]
  labOrders      LabOrder[]
  labReports     LabReport[]
  invoices       Invoice[]
  refillReminders RefillReminder[]

  // IPD Relations
  admissions     Admission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clinicId, phone]) // One patient per phone per clinic
  @@index([clinicId])
  @@index([phone])
  @@index([lastName, firstName])
}

// ============================================================================
// APPOINTMENTS & QUEUE
// ============================================================================

model Appointment {
  id        String @id @default(cuid())
  clinicId  String
  clinic    Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId  String
  doctor    DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  date        DateTime // Date of appointment
  timeSlot    String   // e.g., "10:00-10:15"
  status      AppointmentStatus @default(SCHEDULED)
  type        String   @default("CONSULTATION") // CONSULTATION, FOLLOW_UP, EMERGENCY
  notes       String?
  
  // Relations
  queueToken   QueueToken?
  prescription Prescription?
  invoice      Invoice?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clinicId])
  @@index([patientId])
  @@index([doctorId])
  @@index([date])
  @@index([status])
}

model QueueToken {
  id       String @id @default(cuid())
  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patientId     String
  patient       Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId      String
  doctor        DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  tokenNumber    Int
  status         QueueStatus @default(WAITING)
  estimatedTime  DateTime?   // Estimated consultation time
  calledAt       DateTime?   // When the patient was called
  completedAt    DateTime?

  // WebSocket channel identifier
  channelId String? // e.g., "queue-dr-smith-2026-05-26"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clinicId, doctorId, tokenNumber, createdAt])
  @@index([clinicId])
  @@index([doctorId])
  @@index([status])
  @@index([createdAt])
}

// ============================================================================
// PRESCRIPTIONS & MEDICINE
// ============================================================================

model Prescription {
  id       String @id @default(cuid())

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId  String
  doctor    DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  appointmentId String? @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])

  status    PrescriptionStatus @default(DRAFT)
  diagnosis String?
  notes     String?  // Doctor's notes / advice
  vitals    Json?    // { bp: "120/80", temp: "98.6", weight: "70kg", ... }

  // PDF
  pdfUrl    String?  // S3 URL to generated PDF

  // Relations
  items     PrescriptionItem[]
  labOrders LabOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@index([doctorId])
  @@index([status])
  @@index([createdAt])
}

model PrescriptionItem {
  id             String       @id @default(cuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  medicineId String
  medicine   Medicine @relation(fields: [medicineId], references: [id])

  dosage       String  // e.g., "500mg"
  frequency    String  // e.g., "Twice daily"
  duration     String  // e.g., "7 days"
  quantity     Int     // Total units prescribed
  instructions String? // e.g., "After meals"
  
  // Fulfillment tracking
  dispensedQty Int @default(0)
  isSubstituted Boolean @default(false)
  substituteNote String?

  // Stock status at time of prescribing (snapshot)
  stockAtPrescription Int @default(0)

  createdAt DateTime @default(now())

  @@index([prescriptionId])
  @@index([medicineId])
}

// ============================================================================
// PHARMACY INVENTORY
// ============================================================================

model Medicine {
  id       String @id @default(cuid())
  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  name         String
  genericName  String?
  sku          String?
  category     String   // e.g., "Antibiotic", "Analgesic", "Antidiabetic"
  manufacturer String?
  dosageForm   String   // e.g., "Tablet", "Syrup", "Injection", "Capsule"
  strength     String?  // e.g., "500mg", "10ml"
  
  requiresPrescription Boolean @default(true)
  reorderLevel         Int     @default(10) // Alert when stock falls below

  // Relations
  batches           MedicineBatch[]
  prescriptionItems PrescriptionItem[]
  refillReminders   RefillReminder[]

  // IPD Relations
  medicationOrders  MedicationOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clinicId, name, strength, dosageForm])
  @@index([clinicId])
  @@index([name])
  @@index([genericName])
  @@index([category])
}

model MedicineBatch {
  id         String   @id @default(cuid())
  medicineId String
  medicine   Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  batchNumber    String
  quantity       Int       @default(0)
  costPrice      Decimal   @db.Decimal(10, 2)
  sellingPrice   Decimal   @db.Decimal(10, 2)
  expiryDate     DateTime
  manufacturedDate DateTime?
  status         BatchStatus @default(ACTIVE)
  
  supplier String?

  // Relations
  stockMovements StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([medicineId, batchNumber])
  @@index([medicineId])
  @@index([expiryDate])
  @@index([status])
}

model StockMovement {
  id      String        @id @default(cuid())
  batchId String
  batch   MedicineBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  type        StockMovementType
  quantity    Int       // Positive for in, negative for out
  reason      String?
  reference   String?   // Invoice ID, prescription ID, etc.
  performedBy String    // User ID

  createdAt DateTime @default(now())

  @@index([batchId])
  @@index([type])
  @@index([createdAt])
}

// ============================================================================
// LAB TESTS & REPORTS
// ============================================================================

model LabTest {
  id       String @id @default(cuid())
  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  name        String
  category    String  // "Blood", "Urine", "Imaging", "Pathology"
  description String?
  price       Decimal @db.Decimal(10, 2)
  
  isActive Boolean @default(true)

  // Relations
  labOrders LabOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clinicId, name])
  @@index([clinicId])
  @@index([category])
}

model LabOrder {
  id             String       @id @default(cuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  patientId      String
  patient        Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  labTestId      String
  labTest        LabTest      @relation(fields: [labTestId], references: [id])

  status      LabOrderStatus @default(ORDERED)
  orderedAt   DateTime       @default(now())
  completedAt DateTime?
  notes       String?

  // Relations
  report LabReport?

  @@index([prescriptionId])
  @@index([patientId])
  @@index([status])
}

model LabReport {
  id         String   @id @default(cuid())
  labOrderId String   @unique
  labOrder   LabOrder @relation(fields: [labOrderId], references: [id], onDelete: Cascade)
  patientId  String
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  fileUrl    String   // S3 URL to uploaded PDF
  fileName   String
  fileSize   Int?     // bytes
  notes      String?
  uploadedBy String   // User ID (receptionist)

  createdAt DateTime @default(now())

  @@index([patientId])
}

// ============================================================================
// BILLING & PAYMENTS
// ============================================================================

model Invoice {
  id       String @id @default(cuid())
  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  invoiceNumber String @unique // Auto-generated: INV-2026-00001
  patientId     String
  patient       Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointmentId String? @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])

  subtotal       Decimal       @db.Decimal(10, 2)
  taxAmount      Decimal       @default(0) @db.Decimal(10, 2)
  discountAmount Decimal       @default(0) @db.Decimal(10, 2)
  totalAmount    Decimal       @db.Decimal(10, 2)
  paidAmount     Decimal       @default(0) @db.Decimal(10, 2)
  balanceDue     Decimal       @db.Decimal(10, 2)

  status  InvoiceStatus @default(PENDING)
  dueDate DateTime?
  paidAt  DateTime?

  // Relations
  items    InvoiceItem[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clinicId])
  @@index([patientId])
  @@index([status])
  @@index([createdAt])
}

model InvoiceItem {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  type        InvoiceItemType
  description String  // "Consultation - Dr. Sharma", "Paracetamol 500mg x 10"
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(10, 2)
  totalPrice  Decimal @db.Decimal(10, 2)

  // Reference to source entity
  referenceId   String? // prescriptionItemId, labOrderId, etc.
  referenceType String? // "PRESCRIPTION_ITEM", "LAB_ORDER", "CONSULTATION"

  @@index([invoiceId])
}

model Payment {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  amount        Decimal       @db.Decimal(10, 2)
  method        PaymentMethod
  transactionId String?       // Payment gateway reference
  gatewayResponse Json?       // Raw response from Razorpay/Stripe
  notes         String?

  receivedBy String // User ID
  createdAt  DateTime @default(now())

  @@index([invoiceId])
  @@index([createdAt])
}

// ============================================================================
// DOCTOR PAYOUTS (Admin Analytics)
// ============================================================================

model DoctorPayout {
  id       String @id @default(cuid())
  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  doctorId String
  doctor   DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  periodStart DateTime // Week start
  periodEnd   DateTime // Week end

  totalConsultations  Int
  totalRevenue        Decimal @db.Decimal(10, 2) // Gross consultation revenue
  doctorShare         Decimal @db.Decimal(10, 2) // Doctor's cut
  clinicShare         Decimal @db.Decimal(10, 2) // Clinic's cut
  splitPercent        Decimal @db.Decimal(5, 2)  // Applied split %

  status PayoutStatus @default(PENDING)
  paidAt DateTime?
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clinicId, doctorId, periodStart, periodEnd])
  @@index([clinicId])
  @@index([doctorId])
  @@index([status])
}

// ============================================================================
// REFILL REMINDERS (Cron-Job Engine)
// ============================================================================

model RefillReminder {
  id        String  @id @default(cuid())
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  medicineId String
  medicine   Medicine @relation(fields: [medicineId], references: [id])

  lastDispensedDate DateTime
  nextRefillDate    DateTime
  frequencyDays     Int      // How many days between refills
  status            RefillStatus @default(SCHEDULED)
  
  // Communication
  whatsappMessageId String?  // Meta API message ID
  sentAt            DateTime?
  acknowledgedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@index([nextRefillDate])
  @@index([status])
}

// ============================================================================
// AUDIT LOG
// ============================================================================

model AuditLog {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  action     String  // CREATE, READ, UPDATE, DELETE
  resource   String  // "Patient", "Prescription", "Medicine", etc.
  resourceId String?
  metadata   Json?   // Additional context
  ipAddress  String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([resource, resourceId])
  @@index([createdAt])
}

// ============================================================================
// IPD — WARD, ROOM & BED HIERARCHY
// ============================================================================

model Ward {
  id       String   @id @default(cuid())
  clinicId String
  clinic   Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  name      String       // "Ward A", "ICU-1"
  type      WardType
  floor     Int      @default(0)

  // Relations
  rooms Room[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clinicId, name])
  @@index([clinicId])
  @@index([type])
}

model Room {
  id     String @id @default(cuid())
  wardId String
  ward   Ward   @relation(fields: [wardId], references: [id], onDelete: Cascade)

  number    String               // "101", "ICU-A1"
  dailyRate Decimal @db.Decimal(10, 2) // Per-room pricing (per user request)

  // Relations
  beds Bed[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([wardId, number])
  @@index([wardId])
}

model Bed {
  id     String @id @default(cuid())
  roomId String
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  label  String              // "Bed 1", "Bed A"
  status BedStatus @default(VACANT)

  // Relations
  admissions Admission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roomId, label])
  @@index([roomId])
  @@index([status])
}

// ============================================================================
// IPD — ADMISSION, DISCHARGE & TRANSFER (ADT)
// ============================================================================

model Admission {
  id       String @id @default(cuid())
  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  admittingDoctorId String
  admittingDoctor   DoctorProfile @relation("AdmittingDoctor", fields: [admittingDoctorId], references: [id], onDelete: Cascade)

  attendingDoctorId String?
  attendingDoctor   DoctorProfile? @relation("AttendingDoctor", fields: [attendingDoctorId], references: [id])

  bedId String?
  bed   Bed? @relation(fields: [bedId], references: [id])

  admissionNumber String          @unique  // "ADM-2026-00001"
  status          AdmissionStatus @default(REQUESTED)
  source          AdmissionSource @default(OPD)

  admittedAt      DateTime?
  dischargedAt    DateTime?
  expectedDischargeDate DateTime?

  diagnosis       String?
  chiefComplaints String?
  notes           String?

  // Link back to OPD appointment that triggered admission
  appointmentId String?

  // Relations
  vitalsLogs       VitalsLog[]
  progressNotes    ProgressNote[]
  medicationOrders MedicationOrder[]
  shiftHandovers   ShiftHandover[]
  surgeries        Surgery[]
  ipdBill          IPDBill?
  tpaRecord        TPARecord?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clinicId, status])
  @@index([patientId])
  @@index([bedId])
  @@index([admittingDoctorId])
  @@index([attendingDoctorId])
  @@index([createdAt])
}

// ============================================================================
// IPD — NURSING STATION
// ============================================================================

model VitalsLog {
  id          String    @id @default(cuid())
  admissionId String
  admission   Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  temperature     Decimal? @db.Decimal(4, 1)  // °F (e.g., 98.6)
  systolicBP      Int?                         // mmHg
  diastolicBP     Int?                         // mmHg
  heartRate       Int?                         // bpm
  spO2            Int?                         // percentage
  respiratoryRate Int?                         // breaths/min
  painScale       Int?                         // 0-10
  notes           String?

  recordedBy String                            // User ID (nurse)
  recordedAt DateTime @default(now())

  @@index([admissionId, recordedAt])
  @@index([recordedBy])
}

model ProgressNote {
  id          String    @id @default(cuid())
  admissionId String
  admission   Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  doctorId String
  doctor   DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  content    String     // Rich text / free-form clinical notes
  assessment String?    // Doctor's assessment
  plan       String?    // Treatment plan

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([admissionId])
  @@index([doctorId])
  @@index([createdAt])
}

model MedicationOrder {
  id          String    @id @default(cuid())
  admissionId String
  admission   Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  medicineId String
  medicine   Medicine @relation(fields: [medicineId], references: [id])

  dosage       String                          // "500mg", "10ml"
  frequency    String                          // "Every 8 hours", "BD", "TDS", "QID"
  route        String  @default("ORAL")        // ORAL, IV, IM, SC, TOPICAL, INHALATION
  startDate    DateTime
  endDate      DateTime?
  instructions String?
  orderedBy    String                          // Doctor user ID
  isActive     Boolean @default(true)

  // Relations
  marEntries MAREntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([admissionId])
  @@index([medicineId])
  @@index([isActive])
}

model MAREntry {
  id                String          @id @default(cuid())
  medicationOrderId String
  medicationOrder   MedicationOrder @relation(fields: [medicationOrderId], references: [id], onDelete: Cascade)

  scheduledTime  DateTime
  status         MARStatus @default(SCHEDULED)
  administeredAt DateTime?
  administeredBy String?                       // Nurse User ID
  notes          String?

  createdAt DateTime @default(now())

  @@index([medicationOrderId, scheduledTime])
  @@index([status])
  @@index([administeredBy])
}

model ShiftHandover {
  id          String    @id @default(cuid())
  admissionId String
  admission   Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  shiftType       ShiftType
  shiftDate       DateTime                     // Date of the shift
  shiftStartHour  Int       @default(0)        // Customizable shift start hour (0-23)
  shiftDurationHrs Int      @default(8)        // Customizable shift duration

  outgoingNurseId String                       // User ID
  incomingNurseId String?                      // User ID (null until acknowledged)

  criticalNotes String                         // What the next nurse MUST know
  generalNotes  String?
  acknowledgedAt DateTime?

  createdAt DateTime @default(now())

  @@index([admissionId, shiftDate])
  @@index([outgoingNurseId])
  @@index([shiftType, shiftDate])
}

// ============================================================================
// IPD — OPERATION THEATER (OT)
// ============================================================================

model Surgery {
  id          String @id @default(cuid())
  admissionId String
  admission   Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  name String                                  // "Appendectomy", "CABG", "Laparoscopic Cholecystectomy"

  surgeonId String
  surgeon   DoctorProfile @relation("LeadSurgeon", fields: [surgeonId], references: [id], onDelete: Cascade)

  anesthetistId String?
  anesthetist   DoctorProfile? @relation("Anesthetist", fields: [anesthetistId], references: [id])

  otRoom         String                        // "OT-1", "OT-2"
  scheduledStart DateTime
  scheduledEnd   DateTime
  actualStart    DateTime?
  actualEnd      DateTime?
  status         SurgeryStatus @default(SCHEDULED)

  // Safety checklists (JSON — flexible structure)
  preOpChecklist  Json?   // { consent: true, npo: true, siteMarked: true, bloodGroupConfirmed: true, ... }
  postOpChecklist Json?   // { vitalsSTable: true, drainageChecked: true, painManagement: true, ... }

  estimatedCost Decimal? @db.Decimal(10, 2)
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clinicId, scheduledStart])
  @@index([surgeonId])
  @@index([otRoom, scheduledStart])
  @@index([status])
  @@index([admissionId])
}

// ============================================================================
// IPD — BILLING & RUNNING LEDGER
// ============================================================================

model IPDBill {
  id          String    @id @default(cuid())
  admissionId String    @unique
  admission   Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  // Running totals — updated incrementally by API / cron
  roomCharges     Decimal @default(0) @db.Decimal(10, 2)
  doctorVisitFees Decimal @default(0) @db.Decimal(10, 2)
  nursingCharges  Decimal @default(0) @db.Decimal(10, 2)
  pharmacyCharges Decimal @default(0) @db.Decimal(10, 2)
  surgeryCharges  Decimal @default(0) @db.Decimal(10, 2)
  labCharges      Decimal @default(0) @db.Decimal(10, 2)
  miscCharges     Decimal @default(0) @db.Decimal(10, 2)
  totalAmount     Decimal @default(0) @db.Decimal(10, 2)
  discountAmount  Decimal @default(0) @db.Decimal(10, 2)
  taxAmount       Decimal @default(0) @db.Decimal(10, 2)
  paidAmount      Decimal @default(0) @db.Decimal(10, 2)
  balanceDue      Decimal @default(0) @db.Decimal(10, 2)

  lastAccruedAt DateTime?

  // Relations
  billItems IPDBillItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clinicId])
  @@index([createdAt])
}

model IPDBillItem {
  id        String  @id @default(cuid())
  ipdBillId String
  ipdBill   IPDBill @relation(fields: [ipdBillId], references: [id], onDelete: Cascade)

  category    String                          // "ROOM", "DOCTOR_VISIT", "PHARMACY", "LAB", "SURGERY", "NURSING", "MISC"
  description String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(10, 2)
  totalPrice  Decimal @db.Decimal(10, 2)
  date        DateTime                        // Date the charge was incurred

  referenceId   String?                       // Source entity ID (medicationOrderId, surgeryId, etc.)
  referenceType String?                       // "MEDICATION_ORDER", "SURGERY", "LAB_ORDER", "ROOM_RENT", etc.

  createdAt DateTime @default(now())

  @@index([ipdBillId, date])
  @@index([category])
}

// ============================================================================
// IPD — TPA / INSURANCE
// ============================================================================

model TPARecord {
  id          String    @id @default(cuid())
  admissionId String    @unique
  admission   Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  insurerName    String                        // "Star Health", "ICICI Lombard", "Max Bupa"
  policyNumber   String
  tpaName        String?                       // "Medi Assist", "FHPL"
  memberId       String?                       // Patient's insurance member ID

  preAuthAmount  Decimal? @db.Decimal(10, 2)
  approvedAmount Decimal? @db.Decimal(10, 2)
  claimAmount    Decimal? @db.Decimal(10, 2)
  settledAmount  Decimal? @db.Decimal(10, 2)

  status         TPAStatus @default(PRE_AUTH_PENDING)

  preAuthDocUrl  String?                       // Pre-authorization document URL
  claimDocUrl    String?                       // Claim document URL

  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([admissionId])
}
